platform :ios, '15.0'
use_frameworks! :linkage => :static

target 'AxiomUIHost' do
  # The build script stages the pinned engine at ../engine. This is source
  # input; Axiom never obtains a renderer prebuilt host binary or an engine
  # support pod from the public CocoaPods registry.
  pod 'Lynx', :path => '../engine', :subspecs => ['Framework']
  pod 'LynxBase', :path => '../engine', :subspecs => ['Framework']
  pod 'LynxServiceAPI', :path => '../engine'
  # LynxServiceAPI is only the service registry. The concrete Image subspec
  # supplies the UIImageView factory and SDWebImage decoder used by <image>,
  # including the data: URLs emitted for verified local Axiom assets.
  pod 'LynxService', :path => '../engine', :subspecs => ['Image']
  # Link every XElement-backed primitive in the accepted Phase 2 profile.
  # These are pinned source dependencies compiled into the signed host, not
  # dynamically downloaded framework code.
  pod 'XElement', :path => '../engine', :subspecs => [
    'Input', 'SVG', 'Refresh', 'ViewPager', 'ScrollCoordinator',
    'Overlay', 'BlurView', 'WebView', 'Video'
  ]
  # This pinned engine revision declares PrimJS 4.2.0-alpha.0, while the
  # source checkout's development podspec advertises a newer incompatible
  # version. Let Lynx resolve its declared source pod until PrimJS is vendored
  # and locked as a first-party Axiom source mirror.
end
